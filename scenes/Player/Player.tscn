[sub_resource type="GDScript" id="GDScript_8djf2"]
resource_name = "brainnimation"
script/source = "extends AnimatedSprite2D

@onready var dopamine = get_node_or_null(\"../TextureRect/DopamineBar\");

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	play(\"default\", 1.0, false);


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	if(dopamine.get_dopamine() > 80):
		show();
	else:
		hide();
"

[sub_resource type="GDScript" id="GDScript_hsqoy"]
resource_name = "buildinlabel"
script/source = "extends Label


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	text = \"Time: %d:%02d\" % [int(Globals.current_score / 60.0), int(fmod(Globals.current_score, 60.0))];
"

